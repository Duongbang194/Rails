<header class="header">
        <div class="container">
            <h1 class="logo">Cam Bistro</h1>
        </div>
    </header>
    <section id="home" class="hero">
        <div class="hero-content">
            <h2>Welcome to Cam Bistro</h2>
            <p>Experience the best flavors crafted with passion and quality ingredients.</p>
            <a href="#menu" class="btn">Explore Our Menu</a>
        </div>
    </section>
    <section id="menu" class="menu">
        <h2>Our Menu</h2>
        <div class="menu-container">
            <!-- Sample Menu Items -->
            <div class="menu-item">
                <h3>Grilled Salmon</h3>
                <p>A perfectly grilled salmon served with fresh vegetables.</p>
                <span>$25</span>
            </div>
            <div class="menu-item">
                <h3>Pasta Primavera</h3>
                <p>Classic Italian pasta with seasonal vegetables.</p>
                <span>$18</span>
            </div>
            <!-- Add more items as needed -->
        </div>
    </section>
    <section id="about" class="about">
        <h2>About Us</h2>
        <p>Cam Bistro is dedicated to bringing you a delightful dining experience, offering an ambiance that blends elegance and comfort.</p>
    </section>
    <section id="contact" class="contact">
        <h2>Contact Us</h2>
        <form action="#" method="post">
            <label for="name">Name:</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>

            <label for="message">Message:</label>
            <textarea id="message" name="message" rows="5" required></textarea>

            <button type="submit" class="btn">Send</button>
        </form>
    </section>